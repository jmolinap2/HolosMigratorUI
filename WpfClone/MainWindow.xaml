<Window x:Class="HolosMigratorWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Holos Migrator"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource WindowBgBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#171717"
                BorderBrush="{StaticResource BorderBrushSoft}"
                BorderThickness="0,0,1,0"
                Padding="18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="HolosMigrator"
                               FontSize="13"
                               Foreground="{StaticResource MutedTextBrush}"
                               Margin="2,0,0,18" />
                    <TextBlock Text="&gt; HOLOS"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="MIGRATOR"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               Margin="0,-4,0,22" />

                    <Button x:Name="NavOperations" Content="Operations" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavDashboard" Content="Dashboard" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavStorage" Content="Storage" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavLogs" Content="Log Center" Style="{StaticResource NavButton}" Click="Nav_Click" />
                    <Button x:Name="NavSettings" Content="Settings" Style="{StaticResource NavButton}" Click="Nav_Click" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Style="{StaticResource Card}"
                        Padding="12"
                        Margin="0">
                    <StackPanel>
                        <TextBlock Text="Runtime target"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" />
                        <Button x:Name="EnvironmentButton"
                                Content="STAGING"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,8,0,0"
                                Click="EnvironmentButton_Click" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1A1A1A"
                    BorderBrush="{StaticResource BorderBrushSoft}"
                    BorderThickness="0,0,0,1"
                    Padding="22,0">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OpenScriptsButton" Content="Scripts" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenScriptsButton_Click" />
                        <Button x:Name="OpenLogButton" Content="Log local" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenLogButton_Click" />
                        <Button x:Name="StopButton" Content="Detener" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="StopButton_Click" />
                        <Button x:Name="RunButton" Content="Apply / Ejecutar" Style="{StaticResource PrimaryButton}" Click="RunButton_Click" />
                    </StackPanel>
                    <TextBlock x:Name="EnvironmentStatusText"
                               Text="VPS: SIN VERIFICAR"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="24">
                    <Grid x:Name="PageOperations">
                        <StackPanel>
                            <TextBlock Text="Deployment Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Configure how your deployment and migrations will run." Style="{StaticResource PageSubTitle}" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Accion" Style="{StaticResource LabelText}" />
                                            <ComboBox x:Name="ActionCombo" SelectionChanged="FormState_Changed">
                                                <ComboBoxItem Content="Deploy completo" IsSelected="True" />
                                                <ComboBoxItem Content="Solo migraciones" />
                                            </ComboBox>
                                            <TextBlock Text="Repo local" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="RepoLocalText" Text="C:\Repos\OmniSuite" />
                                            <StackPanel x:Name="AdvancedGeneralPanel">
                                                <TextBlock Text="Repo remoto" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="RemoteRepoPathText" Text="/root/OmniSuite" />
                                                <TextBlock Text="Rama" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="BranchText" Text="develop" />
                                                <TextBlock Text="Archivo compose" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="ComposeFileText" Text="docker-compose.hostinger.yml" />
                                                <TextBlock Text="Token GitHub" Style="{StaticResource LabelText}" />
                                                <PasswordBox x:Name="GitTokenBox" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Deployment and migration" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Objetivo deploy" Style="{StaticResource LabelText}" />
                                            <ComboBox x:Name="DeployTargetCombo">
                                                <ComboBoxItem Content="Both - Front + API" IsSelected="True" />
                                                <ComboBoxItem Content="Backend - Solo API" />
                                                <ComboBoxItem Content="Frontend - Solo Front" />
                                            </ComboBox>
                                            <TextBlock Text="Modo migracion" Style="{StaticResource LabelText}" />
                                            <ComboBox x:Name="MigrationModeCombo" SelectionChanged="FormState_Changed">
                                                <ComboBoxItem Content="B - Host + todos los tenants" IsSelected="True" />
                                                <ComboBoxItem Content="H - Solo Host" />
                                                <ComboBoxItem Content="T - Solo todos los tenants" />
                                                <ComboBoxItem Content="U - Un tenant especifico" />
                                                <ComboBoxItem Content="N - Ninguna" />
                                            </ComboBox>
                                            <TextBlock Text="Tenant (solo modo U)" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="TenantText" />

                                            <WrapPanel Margin="0,8,0,0">
                                                <CheckBox x:Name="SkipPullCheck" Content="Omitir pull" Margin="0,0,18,8" />
                                                <CheckBox x:Name="SkipMigrationsCheck" Content="Omitir migraciones" Margin="0,0,18,8" Checked="FormState_Changed" Unchecked="FormState_Changed" />
                                                <CheckBox x:Name="SkipBuildCheck" Content="Omitir build" Margin="0,0,18,8" />
                                                <CheckBox x:Name="SkipPublicChecksCheck" Content="Omitir checks publicos" Margin="0,0,18,8" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="SSH" Style="{StaticResource SectionTitle}" />
                                            <TextBlock Text="Servidor" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="ServerHostText" LostFocus="ServerField_LostFocus" />
                                            <TextBlock Text="Usuario" Style="{StaticResource LabelText}" />
                                            <TextBox x:Name="ServerUserText" />
                                            <StackPanel x:Name="AdvancedSshPanel">
                                                <TextBlock Text="Puerto SSH" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="SshPortText" Text="22" LostFocus="ServerField_LostFocus" />
                                            </StackPanel>
                                            <TextBlock Text="Modo SSH" Style="{StaticResource LabelText}" />
                                            <ComboBox x:Name="SshAuthCombo" SelectionChanged="FormState_Changed">
                                                <ComboBoxItem Content="Auto - Llave si existe, si no password" IsSelected="True" />
                                                <ComboBoxItem Content="Key - Solo llave SSH" />
                                                <ComboBoxItem Content="Password - Pedir clave SSH" />
                                            </ComboBox>
                                            <TextBlock Text="Password / passphrase" Style="{StaticResource LabelText}" />
                                            <PasswordBox x:Name="SshPasswordBox" PasswordChanged="SshPasswordBox_PasswordChanged" />
                                            <CheckBox x:Name="RememberSshPasswordCheck" Content="Recordar clave SSH cifrada" />
                                            <StackPanel x:Name="AdvancedSshExtrasPanel">
                                                <TextBlock Text="Ruta llave" Style="{StaticResource LabelText}" />
                                                <TextBox x:Name="SshKeyPathText" Text="C:\Users\USER\.ssh\id_ed25519" />
                                                <CheckBox x:Name="SshBatchModeCheck" Content="SshBatchMode (sin prompts)" />
                                                <CheckBox x:Name="InteractivePasswordCheck" Content="Abrir terminal interactiva para password" IsChecked="True" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="Options" Style="{StaticResource SectionTitle}" />
                                            <CheckBox x:Name="CreateRestorePointCheck" Content="Crear punto de control logico antes de ejecutar" IsChecked="True" />
                                            <CheckBox x:Name="RestartExplorerCheck" Content="Reiniciar dashboard/status tras ejecucion" />
                                            <Button x:Name="AdvancedToggleButton" Content="[ SYS.ADVANCED ]" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0" Click="AdvancedToggleButton_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Realtime output" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left" />
                                        <ProgressBar x:Name="RunProgressBar" Height="8" Width="260" Minimum="0" Maximum="100" DockPanel.Dock="Right" />
                                    </DockPanel>
                                    <TextBlock x:Name="StatusBadge" Text="Sistema listo." Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,8" />
                                    <TextBox x:Name="LogTextBox"
                                             Height="260"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             IsReadOnly="True" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageDashboard" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Live VPS reachability, service state and recent runs." Style="{StaticResource PageSubTitle}" />
                            <UniformGrid Columns="4" Margin="0,0,0,16">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="CPU" Style="{StaticResource LabelText}" /><TextBlock x:Name="CpuText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Memory" Style="{StaticResource LabelText}" /><TextBlock x:Name="MemoryText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Disk" Style="{StaticResource LabelText}" /><TextBlock x:Name="DiskText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Uptime" Style="{StaticResource LabelText}" /><TextBlock x:Name="UptimeText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock x:Name="OverallStatusText" Text="Estado VPS: SIN VERIFICAR" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock x:Name="DashboardSourceText" Text="Fuente: pendiente" Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" />
                                            <TextBlock x:Name="LastCheckedText" Text="Ultima verificacion: --" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <Button Content="Refresh dashboard" Style="{StaticResource PrimaryButton}" DockPanel.Dock="Right" Click="RefreshDashboardButton_Click" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="SQL" Style="{StaticResource LabelText}" /><TextBlock x:Name="SqlStatusText" Text="No verificado" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="API" Style="{StaticResource LabelText}" /><TextBlock x:Name="ApiStatusText" Text="No verificado" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Front" Style="{StaticResource LabelText}" /><TextBlock x:Name="FrontStatusText" Text="No verificado" FontWeight="SemiBold" /></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Recent runs" Style="{StaticResource SectionTitle}" />
                                    <DataGrid x:Name="RecentRunsGrid" Height="230" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageStorage" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Storage" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Inspect remote disk and Docker storage usage." Style="{StaticResource PageSubTitle}" />
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                        <Button Content="Refresh" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="RefreshStorageButton_Click" />
                                        <Button Content="Prune builder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PruneBuilderButton_Click" />
                                        <Button Content="Prune images" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PruneImagesButton_Click" />
                                        <Button Content="Prune all" Style="{StaticResource DangerButton}" Click="PruneAllButton_Click" />
                                    </StackPanel>
                                    <TextBlock x:Name="StorageStatusText" Text="Storage no verificado" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </DockPanel>
                            </Border>
                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Disk used" Style="{StaticResource LabelText}" /><TextBlock x:Name="DiskUsedText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="Disk free" Style="{StaticResource LabelText}" /><TextBlock x:Name="DiskFreeText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource Card}" Margin="0"><StackPanel><TextBlock Text="Disk percent" Style="{StaticResource LabelText}" /><TextBlock x:Name="DiskPercentText" Text="--" FontSize="20" FontWeight="SemiBold" /></StackPanel></Border>
                            </UniformGrid>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Docker images" Style="{StaticResource SectionTitle}" />
                                    <DataGrid x:Name="DockerImagesGrid" Height="220" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Top directories" Style="{StaticResource SectionTitle}" />
                                    <DataGrid x:Name="TopDirectoriesGrid" Height="220" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageLogs" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Log Center" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Read local output or pull logs from the VPS." Style="{StaticResource PageSubTitle}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,12">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <ComboBox x:Name="RemoteLogSourceCombo" Width="220" Margin="0,0,8,0">
                                                <ComboBoxItem Content="migrator" IsSelected="True" />
                                                <ComboBoxItem Content="holos-api" />
                                                <ComboBoxItem Content="holos-front" />
                                                <ComboBoxItem Content="holos-sql" />
                                                <ComboBoxItem Content="host-syslog" />
                                                <ComboBoxItem Content="host-auth" />
                                            </ComboBox>
                                            <TextBox x:Name="RemoteLogTailText" Text="300" Width="90" Margin="0,0,8,0" />
                                            <Button Content="Load remote log" Style="{StaticResource PrimaryButton}" Click="LoadRemoteLogButton_Click" />
                                        </StackPanel>
                                        <Button Content="Clear local output" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Click="ClearLogButton_Click" />
                                    </DockPanel>
                                    <TextBox x:Name="RemoteLogTextBox"
                                             Height="460"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="PageSettings" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Settings" Style="{StaticResource PageTitle}" />
                            <TextBlock Text="Local configuration loaded from .env and AppData." Style="{StaticResource PageSubTitle}" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Configuration summary" Style="{StaticResource SectionTitle}" />
                                    <TextBlock x:Name="SettingsSummaryText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                        <Button Content="Reload .env" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="ReloadEnvButton_Click" />
                                        <Button Content="Save local settings" Style="{StaticResource SecondaryButton}" Click="SaveSettingsButton_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
